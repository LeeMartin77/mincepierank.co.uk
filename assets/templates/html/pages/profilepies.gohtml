{{define "page:profilepies"}}
{{template "fragment:global:head" .Head}}
{{template "fragment:components:breadcrumb" .PageData.Breadcrumb}}

<div class="container py-4">
  <h2 class="text-center mb-4">{{.PageData.Heading}}</h2>

  {{if not .PageData.PieCards}}
  <div class="alert alert-info" role="alert">
    You haven't submitted any pies yet.
    <a href="/years/{{.PageData.Year}}/submit">Submit your first pie →</a>
  </div>
  {{end}}

  <div id="pie-list" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    {{ range .PageData.PieCards }}
    <div class="col">
      {{template "fragment:components:profilepielinkcard" .}}
    </div>
    {{ end }}
  </div>
</div>

{{template "fragment:global:foot" .Foot}}
{{end}}
