{{define "page:years"}}
{{template "fragment:global:head" .Head}}
{{template "fragment:components:breadcrumb" .PageData.Breadcrumb}}

<div class="container py-4">
  <h1 class="text-center mb-4">Years</h1>
  <div class="d-grid gap-3" style="max-width: 400px; margin: 0 auto;">
    {{ range .PageData.Years }}
    <a class="btn btn-primary btn-lg" href="/years/{{.}}">{{.}}</a>
    {{ end }}
  </div>
</div>

{{template "fragment:global:foot" .Foot}}
{{end}}
