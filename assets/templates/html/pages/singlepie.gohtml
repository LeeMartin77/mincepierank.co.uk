{{define "page:singlepie"}}
{{template "fragment:global:head" .Head}}
{{template "fragment:components:breadcrumb" .PageData.Breadcrumb}}

<section class="container py-4" id="pie-data-container">
  <div class="row mb-4">
    <div class="col-12">
      <h1 class="h2">{{.PageData.Pie.DisplayName}}</h1>
      {{ if .PageData.HasMaker }}
      <h2 class="h5 text-muted">Made by: {{.PageData.Maker.Name}}</h2>
      {{ end }}
    </div>
  </div>

  <div class="row mb-4 align-items-center">
    <div class="col-md-4 mb-3 mb-md-0">
      <img src="{{.PageData.ImgprssrPrefix}}{{.PageData.Pie.ImageFile}}?filter=gaussian&width=250" class="img-fluid rounded" alt="{{.PageData.Pie.DisplayName}}">
    </div>
    <div class="col-md-8">
      <a href="{{.PageData.Pie.WebLink}}" class="btn btn-outline-primary">Link to Website</a>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-md-6">
      <p><strong>Pack Count:</strong> {{.PageData.Pie.PackCount}}</p>
    </div>
    <div class="col-md-6">
      <p><strong>Pack Price:</strong> £{{printf "%.2f" (ppencediv .PageData.Pie.PackPriceInPence)}}</p>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-12">
      {{template "fragment:components:rankingsummary" .PageData.RankingSummary}}
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      {{template "fragment:components:userranking" dict "Ranking" .PageData.UserRanking "Readonly" .PageData.Readonly "Pie" .PageData.Pie "ActiveYear" .Head.MenuSettings.ActiveYear}}
    </div>
  </div>
</section>

{{template "fragment:global:foot" .Foot}}
{{end}}
