{{define "page:admin:userpies"}}
{{template "fragment:global:head" .Head}}
<div class="container py-4">
  <h1>Admin User Pies - {{.PageData.Year}}</h1>

  {{if .PageData.UserPiesEnabled}}
  <!-- Status summary -->
  <div class="row mb-3">
    <div class="col-auto"><a href="/admin/userpies" class="btn btn-sm btn-outline-secondary">All ({{.PageData.TotalCount}})</a></div>
    <div class="col-auto"><a href="/admin/userpies?status=pending" class="btn btn-sm btn-outline-warning">Pending ({{.PageData.PendingCount}})</a></div>
    <div class="col-auto"><a href="/admin/userpies?status=approved" class="btn btn-sm btn-outline-success">Approved ({{.PageData.ApprovedCount}})</a></div>
    <div class="col-auto"><a href="/admin/userpies?status=promoted" class="btn btn-sm btn-outline-info">Promoted ({{.PageData.PromotedCount}})</a></div>
    <div class="col-auto"><a href="/admin/userpies?status=duplicate" class="btn btn-sm btn-outline-secondary">Duplicate ({{.PageData.DuplicateCount}})</a></div>
    <div class="col-auto"><a href="/admin/userpies?status=rejected" class="btn btn-sm btn-outline-danger">Rejected ({{.PageData.RejectedCount}})</a></div>
    <div class="col-auto"><a href="/admin/userpies/duplicates" class="btn btn-sm btn-outline-primary">Duplicate Groups</a></div>
  </div>

  <!-- Search -->
  <form class="mb-3" method="get">
    <div class="input-group">
      <input class="form-control" name="search" value="{{.PageData.SearchFilter}}" placeholder="Search by name, maker, ID, or user...">
      <button class="btn btn-outline-secondary" type="submit">Search</button>
    </div>
  </form>

  <!-- Table -->
  <div class="table-responsive">
    <table class="table table-striped table-hover" id="userpie-queue">
      <thead>
        <tr>
          <th>Status</th>
          <th>Name</th>
          <th>Maker</th>
          <th>Location</th>
          <th>Labels</th>
          <th>Submitted By</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {{ range .PageData.Rows }}
        <tr>
          <td>
            <span class="badge bg-{{if eq .Status "pending"}}warning{{else if eq .Status "approved"}}success{{else if eq .Status "promoted"}}info{{else if eq .Status "duplicate"}}secondary{{else}}danger{{end}}">
              {{.Status}}
            </span>
          </td>
          <td>{{.DisplayName}}</td>
          <td>{{.Maker}}</td>
          <td>{{.Location}}</td>
          <td>{{range .Labels}}{{.}} {{end}}</td>
          <td>{{.SubmittedBy}}</td>
          <td>
            <a class="btn btn-sm btn-outline-info" href="/admin/userpies/{{.Year}}/{{.ID}}/{{.OwnerUserid}}">Review</a>
            {{if eq .Status "pending"}}
            <form method="post" action="/admin/userpies/{{.Year}}/{{.ID}}/{{.OwnerUserid}}/approve" style="display:inline">
              <button class="btn btn-sm btn-success" type="submit">Approve</button>
            </form>
            <form method="post" action="/admin/userpies/{{.Year}}/{{.ID}}/{{.OwnerUserid}}/reject" style="display:inline">
              <button class="btn btn-sm btn-danger" type="submit">Reject</button>
            </form>
            <form method="post" action="/admin/userpies/{{.Year}}/{{.ID}}/{{.OwnerUserid}}/duplicate" style="display:inline">
              <button class="btn btn-sm btn-outline-warning" type="submit">Mark Duplicate</button>
            </form>
            {{end}}
            {{if not (eq .Status "pending")}}
            <button class="btn btn-sm btn-danger" type="button"
              hx-delete="/admin/userpies/{{.Year}}/{{.ID}}/{{.OwnerUserid}}"
              hx-target="#userpie-queue"
              hx-select="#userpie-queue"
              hx-confirm="Are you sure?">Delete</button>
            {{end}}
          </td>
        </tr>
        {{ end }}
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  {{if gt .PageData.TotalPages 1}}
  <nav>
    <ul class="pagination">
      {{if gt .PageData.Page 1}}
      <li class="page-item">
        <a class="page-link" href="/admin/userpies?page={{sub .PageData.Page 1}}&limit={{.PageData.Limit}}&status={{.PageData.StatusFilter}}&search={{.PageData.SearchFilter}}">Previous</a>
      </li>
      {{end}}
      <li class="page-item disabled">
        <span class="page-link">Page {{.PageData.Page}} of {{.PageData.TotalPages}}</span>
      </li>
      {{if .PageData.ShouldLoadNext}}
      <li class="page-item">
        <a class="page-link" href="/admin/userpies?page={{add .PageData.Page 1}}&limit={{.PageData.Limit}}&status={{.PageData.StatusFilter}}&search={{.PageData.SearchFilter}}">Next</a>
      </li>
      {{end}}
    </ul>
  </nav>
  {{end}}
  {{else}}
  <div class="alert alert-info">User pies are not enabled.</div>
  {{end}}
</div>
{{template "fragment:global:foot" .Foot}}
{{end}}
