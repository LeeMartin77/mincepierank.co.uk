{{define "page:admin:pies"}}
{{template "fragment:global:head" .Head}}
<div class="container py-4">
<h1>Admin Pies</h1>

<div class="card mb-4">
  <div class="card-body">
    <h3>Create Pie</h3>
    <form method="post" action="/admin/makerpies" enctype='multipart/form-data'>
      <div class="row g-3">
        <div class="col-md-3">
          <label class="form-label" for="year">Year</label>
          <input class="form-control" name="year" id="year" type="number" placeholder="Enter year" />
        </div>
        <div class="col-md-3">
          <label class="form-label" for="makerid">Maker Id</label>
          <input class="form-control" name="makerid" id="makerid" type="text" placeholder="Enter maker id" />
        </div>
        <div class="col-md-3">
          <label class="form-label" for="id">ID/Slug</label>
          <input class="form-control" name="id" id="id" type="text" placeholder="Enter ID/Slug" />
        </div>
        <div class="col-md-3">
          <label class="form-label" for="img">Image file</label>
          <input class="form-control" name="img" id="img" type="file">
        </div>
      </div>

      <div class="form-check my-2">
        <input class="form-check-input" name="fresh" value="true" type="checkbox" id="fresh">
        <label class="form-check-label" for="fresh">Fresh</label>
      </div>

      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label" for="displayname">Display Name</label>
          <input class="form-control" name="displayname" id="displayname" type="text" placeholder="Enter display name" />
        </div>
        <div class="col-md-4">
          <label class="form-label" for="web_link">Web Link</label>
          <input class="form-control" name="web_link" id="web_link" type="url" placeholder="Enter web link" />
        </div>
      </div>

      <div class="row g-3 mt-1">
        <div class="col-md-3">
          <label class="form-label" for="pack_count">Pack Count</label>
          <input class="form-control" name="pack_count" id="pack_count" type="number" placeholder="Enter pack count" />
        </div>
        <div class="col-md-3">
          <label class="form-label" for="pack_price_in_pence">Pack Price Pence</label>
          <input class="form-control" name="pack_price_in_pence" id="pack_price_in_pence" type="number" placeholder="Enter pack price in pence" />
        </div>
      </div>

      <div class="form-check my-3">
        <input class="form-check-input" name="validated" value="true" type="checkbox" id="validated">
        <label class="form-check-label" for="validated">Validated</label>
      </div>

      <button class="btn btn-primary" type="submit">Submit</button>
    </form>
  </div>
</div>

<div class="table-responsive mb-5">
<table id="pie-table" class="table table-striped table-hover">
  <thead>
    <tr>
      <th>Year</th>
      <th>Maker ID</th>
      <th>ID</th>
      <th>Display Name</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    {{ range .PageData.Pies }}
    <tr>
      <td>{{.Year}}</td>
      <td>{{.Makerid}}</td>
      <td>{{.ID}}</td>
      <td>{{.Displayname.String}}</td>
      <td>
        <a class="btn btn-sm btn-outline-info" href="/years/{{.Year}}/brands/{{.Makerid}}/{{.ID}}">View</a>
        <a class="btn btn-sm btn-outline-info" href="/admin/makerpies/{{.Oidstr}}">Edit</a>
        <button class="btn btn-sm btn-danger" type="button"
          hx-delete="/admin/makerpies/{{.Oidstr}}"
          hx-target="#pie-table"
          hx-select="#pie-table">Delete</button>
      </td>
    </tr>
    {{ end }}
  </tbody>
</table>
</div>
</div>
{{template "fragment:global:foot" .Foot}}
{{end}}
