{{define "fragment:global:head"}}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <link href="/static/bootstrap@5.3.8.min.css" rel="stylesheet"/>
    <link href="/static/stars.css" rel="stylesheet"/>
    <link href="/static/theme.css" rel="stylesheet"/>
    <script src="/static/htmx.org@2.0.1.min.js" type="application/javascript"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.Title}} :: Mince Pie Rank</title>
    <meta name="description" content="{{.Description}}" />
    <meta name="keywords" content="{{.Keywords}}" />
</head>
<body class="{{ if .IsAdminPage }}mpr-admin{{ else }}mpr-public{{ end }}" hx-boost="true">
    {{ if and .Snow (not .IsAdminPage) }}<canvas id="canvas" aria-hidden="true"></canvas>{{ end }}
    <main class="mpr-main">
    {{ if .IsAdminPage }}
        {{template "fragment:components:menu:admin" .MenuSettings }}
    {{ else }}
        {{template "fragment:components:menu" .MenuSettings }}
    {{ end }}
    <div class="container">
    {{ if .ShowBreadcrumb }}
        {{template "fragment:components:breadcrumb" .Breadcrumbs }}
    {{ end }}
{{end}}
