{{define "fragment:components:userranking"}}
<div class="card mb-4">
  <div class="card-body">
    <h2 class="card-title h4">Your Ranking</h2>
    {{if .Errors}}
    <div class="alert alert-danger" role="alert">
      <strong>Your ranking wasn't saved:</strong>
      <ul class="mb-0">
        {{range .Errors}}
        <li>{{.}}</li>
        {{end}}
      </ul>
    </div>
    {{end}}
    {{if not .Ranking.Year }}
    <h3 class="h6 text-muted">You haven't ranked this!</h3>
    {{else}}
    <h3 class="h6 text-muted">You ranked this on {{timetohuman .Ranking.LastUpdated.Time}}</h3>
    {{end}}
    {{if and (not .Readonly) (eq .ActiveYear .Pie.Year)}}
      <form hx-put="/years/{{.Pie.Year}}/brands/{{.Pie.MakerId}}/{{.Pie.Id}}/rating" hx-swap="outerHTML" hx-select="#pie-data-container" hx-target="#pie-data-container" class="mt-3">
        <div class="row g-3">
          <div class="col-md-6">
            <div class="d-flex align-items-center gap-2 mb-3"><strong>Pastry:</strong> {{template "star-input" dict "Name" "pastry" "Label" "Pastry" "Value" .Ranking.Pastry}}</div>
            <div class="d-flex align-items-center gap-2 mb-3"><strong>Filling:</strong> {{template "star-input" dict "Name" "filling" "Label" "Filling" "Value" .Ranking.Filling}}</div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-center gap-2 mb-3"><strong>Topping:</strong> {{template "star-input" dict "Name" "topping" "Label" "Topping" "Value" .Ranking.Topping}}</div>
            <div class="d-flex align-items-center gap-2 mb-3"><strong>Looks:</strong> {{template "star-input" dict "Name" "looks" "Label" "Looks" "Value" .Ranking.Looks}}</div>
          </div>
        </div>
        <div class="d-flex align-items-center gap-2 mb-3 mt-2"><strong>Value for Money:</strong> {{template "star-input" dict "Name" "value" "Label" "Value for Money" "Value" .Ranking.Value}}</div>
        <button class="btn btn-primary mt-2">Submit</button>
      </form>
    {{else if .Ranking.Year}}
      <div class="row g-3 mt-2">
        <div class="col-md-6">
          <p><strong>Pastry:</strong> {{template "star-display" .Ranking.Pastry}}</p>
          <p><strong>Filling:</strong> {{template "star-display" .Ranking.Filling}}</p>
        </div>
        <div class="col-md-6">
          <p><strong>Topping:</strong> {{template "star-display" .Ranking.Topping}}</p>
          <p><strong>Looks:</strong> {{template "star-display" .Ranking.Looks}}</p>
        </div>
      </div>
      <p><strong>Value for Money:</strong> {{template "star-display" .Ranking.Value}}</p>
    {{end}}
  </div>
</div>
{{end}}
