{{define "fragment:components:rankingsummary"}}
<div class="card mb-4">
  <div class="card-body">
    <h2 class="card-title h4">User Rankings</h2>
    <div class="row">
      <div class="col-md-4">
        <p><strong>Average:</strong> <span class="rating-stars-display">{{template "star-display" .Average}}</span></p>
        <p><strong>Pastry:</strong> <span class="rating-stars-display">{{template "star-display" .Pastry}}</span></p>
      </div>
      <div class="col-md-4">
        <p><strong>Filling:</strong> {{nicefloat .Filling}} <span style="color:#f5b301;">★</span></p>
        <p><strong>Topping:</strong> {{nicefloat .Topping}} <span style="color:#f5b301;">★</span></p>
      </div>
      <div class="col-md-4">
        <p><strong>Looks:</strong> {{nicefloat .Looks}} <span style="color:#f5b301;">★</span></p>
        <p><strong>Value for Money:</strong> {{nicefloat .Value}} <span style="color:#f5b301;">★</span></p>
      </div>
    </div>
  </div>
</div>
{{end}}
