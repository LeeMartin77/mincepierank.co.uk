{{define "fragment:components:rankingsummary"}}
<div class="card mb-4">
  <div class="card-body">
    <h2 class="card-title h4">User Rankings</h2>
    <div class="row">
      <div class="col-md-4">
        <p><strong>Average:</strong> {{template "star-display" .Average}} {{nicefloat .Average}}</p>
        <p><strong>Pastry:</strong> {{template "star-display" .Pastry}} {{nicefloat .Pastry}}</p>
      </div>
      <div class="col-md-4">
        <p><strong>Filling:</strong> {{template "star-display" .Filling}} {{nicefloat .Filling}}</p>
        <p><strong>Topping:</strong> {{template "star-display" .Topping}} {{nicefloat .Topping}}</p>
      </div>
      <div class="col-md-4">
        <p><strong>Looks:</strong> {{template "star-display" .Looks}} {{nicefloat .Looks}}</p>
        <p><strong>Value for Money:</strong> {{template "star-display" .Value}} {{nicefloat .Value}}</p>
      </div>
    </div>
  </div>
</div>
{{end}}
