{{define "fragment:components:menu"}}
<aside class="mpr-menu mpr-frost" id="mpr-menu" aria-label="Main menu">
  <div class="mpr-menu-links">
    <a class="mpr-menu-brand" href="/">Mince Pie Rank</a>
    <a href="/">Home</a>
    <a href="/years/{{.ActiveYear}}/all-pies">All Pies</a>
    <a href="/years/{{.ActiveYear}}/brands">Brands</a>
    <a href="/years/{{.ActiveYear}}/categories">Categories</a>
    <a href="/about">About</a>
    <a href="/profile/rankings/{{.ActiveYear}}">My Rankings</a>
    {{ if and .UserPiesEnabled .SignedIn }}
    <a href="/years/{{.ActiveYear}}/user-pies">Community Pies</a>
    <a href="/years/{{.ActiveYear}}/user-pies/submit">Submit a Pie</a>
    <a href="/profile/pies/{{.ActiveYear}}">My Pies</a>
    {{ else if .UserPiesEnabled }}
    <a href="/years/{{.ActiveYear}}/user-pies">Community Pies</a>
    {{ end }}
  </div>
  <div class="mpr-menu-footer">
    {{ if .SignedIn }}
    <a hx-boost="false" href="/auth/signout">Log Out</a>
    {{ else }}
    <a hx-boost="false" href="/auth/signin">Sign In</a>
    {{ end }}
    <button class="mpr-menu-close" type="button">Close Menu</button>
  </div>
</aside>
<button class="mpr-menu-pill mpr-frost" id="mpr-menu-pill" type="button" aria-controls="mpr-menu" aria-expanded="false">Menu</button>
{{end}}

{{define "fragment:components:menu:admin"}}
<nav class="navbar navbar-expand-lg navbar-light bg-light sticky-top mb-3">
  <div class="container">
    <a class="navbar-brand" href="/">Mince Pie Rank</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
        <li class="nav-item"><a class="nav-link" href="/years/{{.ActiveYear}}/all-pies">All Pies</a></li>
        <li class="nav-item"><a class="nav-link" href="/years/{{.ActiveYear}}/brands">Brands</a></li>
        <li class="nav-item"><a class="nav-link" href="/years/{{.ActiveYear}}/categories">Categories</a></li>
        <li class="nav-item"><a class="nav-link" href="/about">About</a></li>
        <li class="nav-item"><a class="nav-link" href="/profile/rankings/{{.ActiveYear}}">My Rankings</a></li>
        {{ if and .UserPiesEnabled .SignedIn }}
        <li class="nav-item"><a class="nav-link" href="/years/{{.ActiveYear}}/user-pies">Community Pies</a></li>
        <li class="nav-item"><a class="nav-link" href="/years/{{.ActiveYear}}/user-pies/submit">Submit a Pie</a></li>
        <li class="nav-item"><a class="nav-link" href="/profile/pies/{{.ActiveYear}}">My Pies</a></li>
        {{ else if .UserPiesEnabled }}
        <li class="nav-item"><a class="nav-link" href="/years/{{.ActiveYear}}/user-pies">Community Pies</a></li>
        {{ end }}
      </ul>
      <ul class="navbar-nav">
        {{ if .SignedIn }}
        <li class="nav-item"><a hx-boost="false" class="nav-link" href="/auth/signout">Log Out</a></li>
        {{ else }}
        <li class="nav-item"><a hx-boost="false" class="nav-link" href="/auth/signin">Sign In</a></li>
        {{ end }}
      </ul>
    </div>
  </div>
</nav>
{{end}}
