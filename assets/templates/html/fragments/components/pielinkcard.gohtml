{{define "fragment:components:pielinkcard"}}
<div class="card h-100">
  <a href="{{.PieLink}}" class="text-decoration-none text-dark">
    <img src="{{.ImgprssrPrefix}}{{.Pie.ImageFile}}?width=250&height=250&filter=gaussian" class="card-img-top" alt="{{.Pie.DisplayName}}" style="object-fit: cover; height: 250px;">
  </a>
  <div class="card-body">
    <h5 class="card-title"><a href="{{.PieLink}}" class="text-decoration-none text-dark">{{.Pie.DisplayName}}</a></h5>
    {{ if .Maker }}
    <p class="card-text"><small>From <a href="/years/{{.Pie.Year}}/brands/{{.Maker.Id}}">{{ .Maker.Name }}</a></small></p>
    {{ end }}
    <p class="card-text"><strong>Score:</strong> {{ nicefloat .Pie.Average }} ({{.Pie.Count}} Votes)</p>
    {{ if .Pie.PackPriceInPence }}
    <p class="card-text"><small>£{{printf "%.2f" (ppencediv .Pie.PackPriceInPence)}} per Pack</small></p>
    {{ end }}
    <div class="d-flex flex-wrap gap-1 mb-3">
      {{range .CategoryLinks}}
      <a class="badge bg-secondary text-decoration-none" href="{{.URL}}">{{.Label}}</a>
      {{end}}
    </div>
    <a href="{{.PieLink}}" class="btn btn-primary w-100">{{.Pie.DisplayName}}</a>
  </div>
</div>
{{end}}

{{define "fragment:components:toppielinkcard"}}
<div class="card mx-auto" style="max-width: 24rem;">
  <img src="{{.ImgprssrPrefix}}{{.Pie.ImageFile}}?width=250&height=250&filter=gaussian" class="card-img-top" alt="{{.Pie.DisplayName}}" style="object-fit: cover; height: 250px;">
  <div class="card-body">
    <h5 class="card-title">{{.Pie.DisplayName}}</h5>
    <h6 class="card-subtitle mb-2 text-muted">Score: {{ nicefloat .Pie.Average }}</h6>
    {{ if .Maker }}
    <p class="card-text"><small>From <a href="/years/{{.Pie.Year}}/brands/{{.Maker.Id}}">{{ .Maker.Name }}</a></small></p>
    {{ end }}
    <p class="card-text">{{.Pie.Count}} Votes</p>
    {{ if .Pie.PackPriceInPence }}
    <p class="card-text"><small>£{{printf "%.2f" (ppencediv .Pie.PackPriceInPence)}} per Pack</small></p>
    {{ end }}
    <div class="d-flex flex-wrap gap-1 mb-3">
      {{range .CategoryLinks}}
      <a class="badge bg-secondary text-decoration-none" href="{{.URL}}">{{.Label}}</a>
      {{end}}
    </div>
    <a href="{{.PieLink}}" class="btn btn-primary w-100">{{.Pie.DisplayName}}</a>
  </div>
</div>
{{end}}

{{define "fragment:components:latestpielinkcard"}}
<div class="card mx-auto" style="max-width: 24rem;">
  <img src="{{.ImgprssrPrefix}}{{.Pie.ImageFile}}?width=250&height=250&filter=gaussian" class="card-img-top" alt="{{.Pie.DisplayName}}" style="object-fit: cover; height: 250px;">
  <div class="card-body">
    <h5 class="card-title">{{.Pie.DisplayName}}</h5>
    <h6 class="card-subtitle mb-2 text-muted">Scored {{ nicefloat .Pie.Average }}</h6>
    <p class="card-text"><small>at {{ timetohuman .RankingTime }}</small></p>
    {{ if .Maker }}
    <p class="card-text"><small>From <a href="/years/{{.Pie.Year}}/brands/{{.Maker.Id}}">{{ .Maker.Name }}</a></small></p>
    {{ end }}
    {{ if .Pie.PackPriceInPence }}
    <p class="card-text"><small>£{{printf "%.2f" (ppencediv .Pie.PackPriceInPence)}} per Pack</small></p>
    {{ end }}
    <div class="d-flex flex-wrap gap-1 mb-3">
      {{range .CategoryLinks}}
      <a class="badge bg-secondary text-decoration-none" href="{{.URL}}">{{.Label}}</a>
      {{end}}
    </div>
    <a href="{{.PieLink}}" class="btn btn-primary w-100">{{.Pie.DisplayName}}</a>
  </div>
</div>
{{end}}
