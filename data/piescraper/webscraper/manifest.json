{
  "manifest_version": 3,
  "name": "Piescraper",
  "version": "2.0",

  "description": "Scrape mince pie product pages into a bulk upload archive for mincepierank.co.uk",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "48": "icons/chart-pie-outline-48.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "piescraper@leejohnmartin.co.uk",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_icon": "icons/chart-pie-outline-32.png",
    "theme_icons": [
      {
        "light": "icons/chart-pie-outline-32.png",
        "dark": "icons/chart-pie-outline-32.png",
        "size": 32
      }
    ],
    "default_title": "Piescraper",
    "default_popup": "popup.html"
  },

  "background": {
    "scripts": ["background.js"]
  }
}
